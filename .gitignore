# Local test renders and demo-specific configs/step lists — no demo is
# committed to the public repo. Only the generic templates and the one
# hand-written example stay tracked; every real demo is local-only, and
# finished videos get shared externally (e.g. YouTube), not as repo assets.
/local-renders/
/config/*.json
!/config/staging.json
!/config/prod.json
# Public, no-login QA/test-automation practice sites — generic reusable
# fixtures for stress-testing this tool, not personal demo content.
!/config/saucedemo.json
!/config/the-internet.json
!/config/demoqa.json
/steps/*.json
!/steps/example-flow.json
